<!--
  Lookout custom detection rules.

  These close the gaps found in Phase 2: techniques that the Atomic Red Team
  tests executed but Wazuh's default ruleset did not alert on. See
  lab/atomic/RUNBOOK.md for the full coverage results.

  Deploy: copy to /var/ossec/etc/rules/local_rules.xml on the manager, then
  `sudo systemctl restart wazuh-manager`.

  Custom rule IDs use the 100000+ range reserved for local rules.

  Each rule matches the Windows eventchannel fields that the Sysmon decoder
  populates (win.system.channel, win.system.eventID, win.eventdata.*), so it
  does not depend on default Sysmon rule IDs that shift between versions.
-->
<group name="sysmon,lookout,">

  <!--
    T1003.001 - OS Credential Dumping: LSASS Memory
    Catches: any process opening a handle to lsass.exe (Sysmon event 10,
    ProcessAccess). This is the single most important gap found: the comsvcs.dll
    MiniDump test ran and the defaults stayed silent.
    False positives: legitimate security tooling (EDR, some backup agents) and
    Windows Defender itself read LSASS. In this lab nothing should, so level 12.
    In a real environment, exclude known-good sourceImage paths before alerting.
  -->
  <rule id="100010" level="12">
    <if_group>windows</if_group>
    <field name="win.system.channel">Microsoft-Windows-Sysmon/Operational</field>
    <field name="win.system.eventID">^10$</field>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)\\lsass\.exe$</field>
    <description>Credential dumping: $(win.eventdata.sourceImage) accessed LSASS memory (granted $(win.eventdata.grantedAccess))</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
    <group>credential_access,pci_dss_10.6.1,gdpr_IV_35.7.d,</group>
  </rule>

  <!--
    T1547.001 - Boot or Logon Autostart: Registry Run Keys
    Catches: a value written to a Run / RunOnce autostart key (Sysmon event 13,
    RegistryEvent value set).
    False positives: installers and updaters legitimately add Run keys. Medium
    severity, so it surfaces for review without screaming.
  -->
  <rule id="100030" level="10">
    <if_group>windows</if_group>
    <field name="win.system.channel">Microsoft-Windows-Sysmon/Operational</field>
    <field name="win.system.eventID">^13$</field>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)\\(CurrentVersion\\Run|CurrentVersion\\RunOnce)\\</field>
    <description>Persistence: registry Run key value set -> $(win.eventdata.targetObject)</description>
    <mitre>
      <id>T1547.001</id>
    </mitre>
    <group>persistence,</group>
  </rule>

  <!--
    T1033 / T1082 / T1016 - Discovery via built-in binaries
    Catches: common host/network/user recon tools running (Sysmon event 1).
    One of these alone is normal admin activity, so this is deliberately low
    severity (level 6). The real value comes in Phase 5, where the AI clusters
    several of these from one host in a short window into one escalation.
    False positives: high. Admins and scripts run these constantly. Do not page
    on a single hit; use it as a correlation signal.
  -->
  <rule id="100020" level="6">
    <if_group>windows</if_group>
    <field name="win.system.channel">Microsoft-Windows-Sysmon/Operational</field>
    <field name="win.system.eventID">^1$</field>
    <field name="win.eventdata.originalFileName" type="pcre2">(?i)^(whoami\.exe|systeminfo\.exe|ipconfig\.exe|net\.exe|net1\.exe|nltest\.exe|quser\.exe|hostname\.exe|tasklist\.exe)$</field>
    <description>Discovery: recon binary executed -> $(win.eventdata.originalFileName) by $(win.eventdata.parentImage)</description>
    <mitre>
      <id>T1033</id>
      <id>T1082</id>
      <id>T1016</id>
    </mitre>
    <group>discovery,</group>
  </rule>

  <!--
    T1560.001 - Archive Collected Data via a living-off-the-land tool
    Catches: makecab.exe or similar built-in archivers launching (Sysmon event 1).
    Attackers use these to stage data before exfiltration.
    False positives: Windows servicing and some installers call makecab. Medium.
  -->
  <rule id="100040" level="8">
    <if_group>windows</if_group>
    <field name="win.system.channel">Microsoft-Windows-Sysmon/Operational</field>
    <field name="win.system.eventID">^1$</field>
    <field name="win.eventdata.originalFileName" type="pcre2">(?i)^(makecab\.exe|diantz\.exe)$</field>
    <description>Collection: archiving tool launched -> $(win.eventdata.commandLine)</description>
    <mitre>
      <id>T1560.001</id>
    </mitre>
    <group>collection,</group>
  </rule>

  <!--
    T1053.005 - Scheduled Task creation from the command line
    Catches: schtasks.exe /create (Sysmon event 1). The defaults only caught the
    script this test dropped in C:\, not the task registration itself. This names
    the technique correctly.
    False positives: legitimate software installs scheduled tasks. Medium.
  -->
  <rule id="100050" level="8">
    <if_group>windows</if_group>
    <field name="win.system.channel">Microsoft-Windows-Sysmon/Operational</field>
    <field name="win.system.eventID">^1$</field>
    <field name="win.eventdata.originalFileName" type="pcre2">(?i)^schtasks\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)/create</field>
    <description>Persistence: scheduled task created from command line -> $(win.eventdata.commandLine)</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
    <group>persistence,</group>
  </rule>

</group>
