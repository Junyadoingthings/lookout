# Every environment variable the project uses, with no real values.
# Real values never go in git. The phase that first needs each one is in brackets.
#
# Where they live:
#   Console (Next.js)  -> app/.env.local for local dev, Vercel project settings in production
#   Lab scripts        -> .env in the repo root, on your Mac only
#
# Anything starting with NEXT_PUBLIC_ is sent to the browser. Only put values there
# that are safe for anyone to see.

# ---------------------------------------------------------------------------
# Console: database [Phase 3]
# ---------------------------------------------------------------------------

# Supabase Postgres, pooled connection (Supavisor, transaction mode, port 6543).
# Used by the app at runtime. Server only.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Supabase Postgres, direct connection (port 5432). Used only by Drizzle migrations.
DATABASE_URL_DIRECT=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# ---------------------------------------------------------------------------
# Console: analyst login [Phase 4]
# ---------------------------------------------------------------------------

# Supabase project URL and publishable key. Safe in the browser: row-level
# security decides what this key can read.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# The one email allowed into analyst mode. Everyone else gets the read-only demo.
ANALYST_EMAIL=you@example.com

# ---------------------------------------------------------------------------
# Console: AI [Phase 5]
# ---------------------------------------------------------------------------

# Anthropic API key. Server only. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=sk-ant-xxx

# Model used for fresh analysis. Recorded next to every AI result.
ANTHROPIC_MODEL=claude-sonnet-5

# Hard cap on fresh AI calls per day, across all analyst actions. Stops a bug or
# a stolen session from running up the bill.
AI_MAX_CALLS_PER_DAY=200

# ---------------------------------------------------------------------------
# Console + lab: live ingest [Phase 6]
# ---------------------------------------------------------------------------

# Shared secret for HMAC-signing alerts pushed from Wazuh to the console.
# Generate with: openssl rand -hex 32. Same value on both sides.
INGEST_HMAC_SECRET=

# Full URL of the console's ingest endpoint (lab side only).
INGEST_URL=https://your-app.vercel.app/api/ingest

# ---------------------------------------------------------------------------
# Lab: alert export [Phase 3]
# ---------------------------------------------------------------------------

# Wazuh indexer API on the Ubuntu VM. Port 9200, HTTPS with a self-signed cert.
WAZUH_INDEXER_URL=https://192.168.64.10:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=

# Path to the Wazuh root CA copied off the VM, so the export script can check
# the indexer's certificate instead of turning verification off.
WAZUH_INDEXER_CA_CERT=./lab/export/root-ca.pem
